#: data/dev.mysh.valapad.desktop.in:6 data/dev.mysh.valapad.metainfo.xml.in:7
msgid "ValaPad"
msgstr "ValaPad"

#: data/dev.mysh.valapad.desktop.in:7
msgid "Edit plain-text files"
msgstr "Nur-Text-Dateien bearbeiten"

#: data/dev.mysh.valapad.desktop.in:9
msgid "valapad;text;editor;plain;"
msgstr "valapad;text;editor;einfach;"

#: data/dev.mysh.valapad.desktop.in:20
msgid "New Window"
msgstr "Neues Fenster"

#: data/dev.mysh.valapad.metainfo.xml.in:8
msgid "Edit plain-text files with a familiar set of tools"
msgstr "Nur-Text-Dateien mit vertrauten Werkzeugen bearbeiten"

#: data/dev.mysh.valapad.metainfo.xml.in:10
msgid "Iaroslav Angliuster"
msgstr "Iaroslav Angliuster"

#: data/dev.mysh.valapad.metainfo.xml.in:13
msgid ""
"ValaPad is a lightweight plain-text editor with a familiar menu bar and a "
"live status bar showing line and column, zoom level, line-ending style, and "
"encoding. Exciting!"
msgstr ""
"ValaPad ist ein Nur-Text-Editor mit einer vertrauten Menüleiste und einer "
"dynamischen Statusleiste, die Zeile und Spalte, Zoomstufe, Zeilenendestil "
"und Zeichenkodierung anzeigt."

#: data/dev.mysh.valapad.metainfo.xml.in:32
msgid "Changed strings related to RDNN change, no visual changes."
msgstr ""

#: data/dev.mysh.valapad.metainfo.xml.in:37
msgid "Fixed link to the screenshot of the app."
msgstr ""

#: data/dev.mysh.valapad.metainfo.xml.in:42
msgid "Changed RDNN string to previous one."
msgstr "Die RDNN wurde auf die vorherige zurückgesetzt."

#: data/dev.mysh.valapad.metainfo.xml.in:43
msgid "Fixed Russian and German translations."
msgstr "Die russischen und deutschen Übersetzungen wurden korrigiert."

#: data/dev.mysh.valapad.metainfo.xml.in:44
msgid "Currently used font is now highlighted in fonts menu."
msgstr ""
"Die aktuell verwendete Schriftart wird jetzt im Schriftartenmenü "
"hervorgehoben."

#: data/dev.mysh.valapad.metainfo.xml.in:49
msgid "Changed RDNN string due to publishing requirements."
msgstr "Die RDNN wurde aufgrund der Veröffentlichungsanforderungen geändert."

#: data/dev.mysh.valapad.metainfo.xml.in:50
msgid "Previous: dev.mysh.valapad"
msgstr "Vorher: dev.mysh.valapad"

#: data/dev.mysh.valapad.metainfo.xml.in:51
msgid "New: dev.mysh.valapad"
msgstr "Neu: dev.mysh.valapad"

#: data/dev.mysh.valapad.metainfo.xml.in:56
msgid "Added the icon."
msgstr "Das Icon wurde hinzugefügt."

#: data/dev.mysh.valapad.metainfo.xml.in:61
msgid "Initial release."
msgstr "Erstveröffentlichung."

