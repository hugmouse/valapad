#: data/dev.mysh.valapad.desktop.in:6 data/dev.mysh.valapad.metainfo.xml.in:7
msgid "ValaPad"
msgstr "ValaPad"

#: data/dev.mysh.valapad.desktop.in:7
msgid "Edit plain-text files"
msgstr "Редактируйте текстовые файлы"

#: data/dev.mysh.valapad.desktop.in:9
msgid "valapad;text;editor;plain;"
msgstr "valapad;текст;редактор;обычный текст;"

#: data/dev.mysh.valapad.desktop.in:20
msgid "New Window"
msgstr "Новое окно"

#: data/dev.mysh.valapad.metainfo.xml.in:8
msgid "Edit plain-text files with a familiar set of tools"
msgstr "Редактируйте текстовые файлы с помощью знакомых инструментов"

#: data/dev.mysh.valapad.metainfo.xml.in:10
msgid "Iaroslav Angliuster"
msgstr "Ярослав Англюстер"

#: data/dev.mysh.valapad.metainfo.xml.in:13
msgid ""
"ValaPad is a lightweight plain-text editor with a familiar menu bar and a "
"live status bar showing line and column, zoom level, line-ending style, and "
"encoding. Exciting!"
msgstr ""
"ValaPad — лёгкий редактор текста с привычной строкой меню и динамической "
"строкой состояния, которая показывает строку и столбец, масштаб, тип "
"окончания строк и кодировку."

#: data/dev.mysh.valapad.metainfo.xml.in:32
msgid "Changed RDNN string to previous one."
msgstr "Прежний идентификатор RDNN восстановлен."

#: data/dev.mysh.valapad.metainfo.xml.in:33
msgid "Fixed Russian and German translations."
msgstr "Исправлены переводы на русский и немецкий языки."

#: data/dev.mysh.valapad.metainfo.xml.in:34
msgid "Currently used font is now highlighted in fonts menu."
msgstr "Используемый шрифт теперь выделен в меню шрифтов."

#: data/dev.mysh.valapad.metainfo.xml.in:39
msgid "Changed RDNN string due to publishing requirements."
msgstr "Идентификатор RDNN изменён в соответствии с требованиями публикации."

#: data/dev.mysh.valapad.metainfo.xml.in:40
msgid "Previous: dev.mysh.valapad"
msgstr "Прежний: dev.mysh.valapad"

#: data/dev.mysh.valapad.metainfo.xml.in:41
msgid "New: dev.mysh.valapad"
msgstr "Новый: dev.mysh.valapad"

#: data/dev.mysh.valapad.metainfo.xml.in:46
msgid "Added the icon."
msgstr "Добавлен значок приложения."

#: data/dev.mysh.valapad.metainfo.xml.in:51
msgid "Initial release."
msgstr "Первый релиз."

#~ msgid "Edit text with familiar menus and a live status bar"
#~ msgstr "Редактирование текста с привычными меню и строкой состояния"

#~ msgid ""
#~ "Find and replace text, jump to a line, choose line wrapping, and work "
#~ "with UTF-8 files using either LF or CRLF line endings."
#~ msgstr ""
#~ "Ищите и заменяйте текст, переходите к нужной строке, выбирайте перенос "
#~ "строк и работайте с файлами UTF-8 с окончаниями строк LF или CRLF."
