<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<component type="desktop-application">
  <id>dev.mysh.valapad</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>ValaPad</name>
  <summary>Edit plain-text files with a familiar set of tools</summary>
  <developer id="com.github.hugmouse">
    <name>Iaroslav Angliuster</name>
  </developer>
  <description>
    <p>
      ValaPad is a lightweight plain-text editor with a familiar menu
      bar and a live status bar showing line and column, zoom level,
      line-ending style, and encoding. Exciting!
    </p>
  </description>
  <screenshots>
    <screenshot type="default">
      <image>https://github.com/hugmouse/valapad/raw/@VERSION@/data/screenshots/main.webp?raw=true</image>
    </screenshot>
  </screenshots>
  <launchable type="desktop-id">dev.mysh.valapad.desktop</launchable>
  <url type="homepage">https://github.com/hugmouse/valapad</url>
  <branding>
    <color type="primary">#3689e6</color>
  </branding>
  <releases>
    <release version="1.1.1" date="2026-08-02">
      <description>
        <p>Fixes related to the release on GitHub, no visual changes.</p>
      </description>
    </release>
    <release version="1.1.0" date="2026-08-02">
      <description>
        <p>The autosave feature has been added. ValaPad regularly saves your changes, so if app crashes, you can still restore the document.</p>
      </description>
    </release>
    <release version="1.0.4" date="2026-07-27">
      <description>
        <p>Changed strings related to RDNN change, no visual changes.</p>
      </description>
    </release>
    <release version="1.0.3" date="2026-07-26">
      <description>
        <p>Fixed link to the screenshot of the app.</p>
      </description>
    </release>
    <release version="1.0.2" date="2026-07-26">
      <description>
        <p>Changed RDNN string to previous one.</p>
        <p>Fixed Russian and German translations.</p>
        <p>Currently used font is now highlighted in fonts menu.</p>
      </description>
    </release>
    <release version="1.0.1" date="2026-07-20">
      <description>
        <p>Changed RDNN string due to publishing requirements.</p>
        <p>Previous: dev.mysh.valapad</p>
        <p>New: dev.mysh.valapad</p>
      </description>
    </release>
    <release version="1.0.0" date="2026-07-20">
      <description>
        <p>Added the icon.</p>
      </description>
    </release>
    <release version="0.9.0" date="2026-07-16">
      <description>
        <p>Initial release.</p>
      </description>
    </release>
  </releases>
  <content_rating type="oars-1.1" />
  <recommends>
    <control>keyboard</control>
    <control>touch</control>
  </recommends>
</component>
