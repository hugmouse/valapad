<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<component type="desktop-application">
  <id>dev.mysh.valapad</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>ValaPad</name>
  <summary>Edit plain-text files with a familiar set of tools</summary>
  <developer id="com.github.hugmouse">
    <name>Iaroslav Angliuster</name>
  </developer>
  <description>
    <p>
      ValaPad is a lightweight plain-text editor with a familiar menu
      bar and a live status bar showing line and column, zoom level,
      line-ending style, and encoding. Exciting!
    </p>
  </description>
  <screenshots>
    <screenshot type="default">
      <image>https://github.com/hugmouse/valapad/raw/@VERSION@/data/screenshots/main.webp</image>
      <caption>Edit plain-text files with a familiar set of tools</caption>
    </screenshot>
    <screenshot>
      <image>https://github.com/hugmouse/valapad/raw/@VERSION@/docs/screenshots/recover-documents.webp</image>
      <caption>Recover unsaved documents after a crash</caption>
    </screenshot>
  </screenshots>
  <launchable type="desktop-id">dev.mysh.valapad.desktop</launchable>
  <url type="homepage">https://github.com/hugmouse/valapad</url>
  <url type="bugtracker">https://github.com/hugmouse/valapad/issues</url>
  <provides>
    <binary>dev.mysh.valapad</binary>
  </provides>
  <branding>
    <color type="primary">#3689e6</color>
  </branding>
  <releases>
    <release version="1.2.0" date="2026-09-24">
      <description>
        <p>Escape closes the search and replace bar, and the go to, font and recovery dialogs.</p>
        <p>Errors open in a proper dialog instead of an alert that printed the message twice.</p>
        <p>Cancelling the prompt for a binary or oversized file no longer leaves an empty window behind.</p>
        <p>Monospace fonts no longer appear under Sans Serif in the font dialog.</p>
        <p>The About dialog shows the website, the author and the translators.</p>
      </description>
    </release>
    <release version="1.1.1" date="2026-08-02">
      <description>
        <p>Fixes related to the release on GitHub, no visual changes.</p>
      </description>
    </release>
    <release version="1.1.0" date="2026-08-02">
      <description>
        <p>The autosave feature has been added. ValaPad regularly saves your changes, so if app crashes, you can still restore the document.</p>
      </description>
    </release>
    <release version="1.0.4" date="2026-07-27">
      <description>
        <p>Changed strings related to RDNN change, no visual changes.</p>
      </description>
    </release>
    <release version="1.0.3" date="2026-07-26">
      <description>
        <p>Fixed link to the screenshot of the app.</p>
      </description>
    </release>
    <release version="1.0.2" date="2026-07-26">
      <description>
        <p>Changed RDNN string to previous one.</p>
        <p>Fixed Russian and German translations.</p>
        <p>Currently used font is now highlighted in fonts menu.</p>
      </description>
    </release>
    <release version="1.0.1" date="2026-07-20">
      <description>
        <p>Changed the application ID to meet AppCenter publishing requirements.</p>
      </description>
    </release>
    <release version="1.0.0" date="2026-07-20">
      <description>
        <p>Added the icon.</p>
      </description>
    </release>
    <release version="0.9.0" date="2026-07-16">
      <description>
        <p>Initial release.</p>
      </description>
    </release>
  </releases>
  <content_rating type="oars-1.1" />
  <supports>
    <control>keyboard</control>
    <control>touch</control>
    <control>pointing</control>
  </supports>
</component>
